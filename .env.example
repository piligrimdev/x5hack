DATABASE_URL=postgresql+psycopg2://postgres:password@db:5432/x5hack
SERVICE_NAME=webx5

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=x5hack

PORT=8000

JWT_SECRET_KEY=change-me-in-production
JWT_TTL_DAYS=7
JWT_REFRESH_TTL_DAYS=14
TERMINAL_TOKEN=change-me-in-production

# Shared by the challenges LLM-agent (feature 006-user-challenges) and the
# basket assistant (POST /basket/assistant) — both call OpenRouter.
OPENROUTER_API_KEY=change-me-in-production

# --- Challenges (feature 006-user-challenges) ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CHALLENGE_LLM_MODEL=anthropic/claude-haiku-4.5
CHALLENGE_TYPE_DEFAULT=llm
SYNTH_CONFIG_PATH=/config/synth_schema.yaml

# --- Basket assistant ("Аппи", POST /basket/assistant) ---
# deepseek/deepseek-chat was tried first but responds in 25-37s (near the
# 30s HTTP timeout in core/llm.py) — switched to claude-haiku-4.5, which
# responds in ~1-2s for this tool-calling workload.
BASKET_LLM_MODEL=google/gemini-3.1-flash-lite
