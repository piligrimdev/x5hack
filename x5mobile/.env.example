# URL бэкенда.
# Симулятор / npm run web:  http://localhost:8000
# Устройство:               http://192.168.x.x:8000  (IP вашей машины в локальной сети)
# Docker-демо (nginx):      оставь пустым — запросы идут на тот же origin
EXPO_PUBLIC_API_URL=http://localhost:8000

# npm run web: phone | fullscreen
EXPO_PUBLIC_WEB_LAYOUT=phone
